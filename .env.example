# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del framework de chatbots.
# Copia este archivo como `framework/.env` (o `.env` en la raíz) y llena SOLO lo que uses.
# ⚠️ Nunca subas el archivo .env al repositorio (ya está en .gitignore).
# Valores vacíos = la función queda apagada. Nada aquí es un secreto real.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor
PORT=3000
# Carpeta de bots (por defecto ../bots respecto de framework/)
BOTS_DIR=
# Token para /admin/* (reactivar el bot tras una derivación, listar conversaciones). Pon una cadena larga al azar.
ADMIN_TOKEN=

# ── Inteligencia artificial
# Selección automática: ANTHROPIC_API_KEY → Anthropic; DEEPSEEK_API_KEY → DeepSeek; `claude` instalado → CLI (solo desarrollo); si no → mock.
# Forzar uno: anthropic | deepseek | claude-cli | mock
LLM_PROVIDER=
# Clave de console.anthropic.com (producción recomendada)
ANTHROPIC_API_KEY=
# Alternativa: DeepSeek (API compatible con OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
# Forzar modelos concretos (opcional; por defecto se traducen los alias de bot.yaml: claude-haiku / claude-sonnet)
LLM_MODEL_RAPIDO=
LLM_MODEL_EXPERTO=
LLM_MODEL_JUEZ=
# Solo desarrollo con la CLI de Claude Code: límites para no gastar de más
CLAUDE_CLI_MAX_CALLS=400
CLAUDE_CLI_CONCURRENCY=2
CLAUDE_CLI_TIMEOUT_MS=120000

# ── Telegram (canal de prueba prioritario) — token de @BotFather
TELEGRAM_BOT_TOKEN=
# Un token distinto por bot (opcional): TELEGRAM_BOT_TOKEN_<ID_DEL_BOT_EN_MAYUSCULAS>, ej.:
TELEGRAM_BOT_TOKEN_MOKALU=
# Modo webhook (producción): secreto que Telegram envía en cada llamada
TELEGRAM_WEBHOOK_SECRET=
# Chat (grupo de asesores) que recibe avisos de derivación; ahí se usa /reactivar <bot> <usuario>
TELEGRAM_ADMIN_CHAT_ID=

# ── Derivación a humanos
# Pausar el bot en ese chat cuando deriva (true por defecto) y cuántas horas dura la pausa antes de reactivarse solo
HANDOFF_PAUSE=true
HANDOFF_PAUSE_HOURS=12
# Webhook (n8n, Make…) que recibe cada derivación en JSON
HANDOFF_WEBHOOK_URL=
HANDOFF_WEBHOOK_SECRET=

# ── Destinos de los bots (referenciados en bots/<id>/bot.yaml como ${VARIABLE}); números en formato +593...
WHATSAPP_ASESOR_VENTAS=
WHATSAPP_DISTRIBUIDORES=
WHATSAPP_RECLAMOS=
WHATSAPP_SERVICIO_CLIENTE=

# ── Agrupar mensajes seguidos del mismo cliente antes de responder (segundos; 0 = apagado)
DEBOUNCE_SECONDS=3

# ── Seguimientos automáticos (bot.yaml → seguimiento). Requiere una persistencia con listado (Supabase o memoria del proceso)
FOLLOWUPS_ENABLED=false
FOLLOWUPS_INTERVAL_MS=300000

# ── Persistencia (opcional). Sin esto, todo queda en memoria y se pierde al reiniciar.
SUPABASE_URL=
# Service role key: SOLO en el servidor, nunca en el navegador
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# FUTURO — Meta (WhatsApp Cloud API / Instagram). NO se conecta todavía.
# Aunque llenes estas variables, el envío real queda apagado salvo META_ENABLE_SEND=true.
# ─────────────────────────────────────────────────────────────────────────────
META_ENABLE_SEND=false
META_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Periskope (alternativa gestionada de WhatsApp) — esqueleto, envío apagado por defecto
PERISKOPE_API_URL=
PERISKOPE_API_KEY=
PERISKOPE_WEBHOOK_SECRET=
PERISKOPE_ENABLE_SEND=false
