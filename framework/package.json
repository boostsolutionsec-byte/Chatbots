{
  "name": "chatbots-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Motor reutilizable de chatbots de venta y atenci\u00f3n: un bot = una carpeta bots/<id>/",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "sim": "tsx src/cli/sim.ts",
    "eval": "tsx src/cli/eval.ts",
    "telegram": "tsx src/cli/telegram.ts",
    "validate": "tsx src/cli/validate.ts",
    "n8n:build": "tsx src/cli/n8n-build.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
